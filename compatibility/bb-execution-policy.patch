diff --git a/apps/server/src/services/execution-policies/runtime.test.ts b/apps/server/src/services/execution-policies/runtime.test.ts
new file mode 100644
index 0000000..5f47bbf
--- /dev/null
+++ b/apps/server/src/services/execution-policies/runtime.test.ts
@@ -0,0 +1,359 @@
+import { afterEach, describe, it, expect } from "vitest";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { randomUUID } from "node:crypto";
+import {
+  createExecutionPolicyRuntime,
+  type ExecutionPolicyRow,
+} from "./runtime.js";
+const directories: string[] = [];
+afterEach(() => {
+  for (const p of directories.splice(0))
+    rmSync(p, { recursive: true, force: true });
+});
+const profile = {
+  model: "efficient",
+  reasoningLevel: "medium",
+  serviceTier: "default",
+};
+const original = {
+  model: "primary",
+  reasoningLevel: "high",
+  serviceTier: "fast",
+};
+function fixture() {
+  const directory = mkdtempSync(join(tmpdir(), "bb-policy-test-"));
+  directories.push(directory);
+  const statePath = join(directory, "journal.json");
+  const row: ExecutionPolicyRow = {
+    id: "thread",
+    providerId: "codex",
+    hostId: "host",
+    deleted: false,
+    archived: false,
+    paused: false,
+    status: "idle",
+    activeTurnId: null,
+    lastRequestId: null,
+    available: true,
+    unavailableReason: null,
+    source: {
+      providerId: "codex",
+      allowFastServiceTier: true,
+      modelOverride: null,
+      reasoningLevelOverride: null,
+      lastExecution: { ...original },
+      defaults: { ...original },
+    },
+    sessionSnapshot: { selection: "original" },
+  };
+  const rows = [row];
+  const options = {
+    allowMissing: true,
+    statePath,
+    providerId: "codex",
+    profile,
+    adapter: {
+      list: () => rows,
+      get: (id: string) => rows.find((r) => r.id === id) ?? null,
+    },
+  };
+  const runtime = createExecutionPolicyRuntime(options);
+  runtime.attach();
+  const set = (enabled: boolean) =>
+    runtime.set({
+      enabled,
+      expectedGeneration: runtime.status().generation,
+      requestId: randomUUID(),
+    });
+  const command = (requestId = randomUUID()) => ({
+    type: "turn.submit",
+    threadId: row.id,
+    requestId,
+    options: {
+      ...original,
+      permissionMode: "full",
+      source: "client/turn/requested",
+      providerOptions: { model: "primary" },
+    },
+    target: { mode: "start" },
+  });
+  return { runtime, options, row, rows, set, command, statePath };
+}
+describe("server-owned effective execution", () => {
+  it("omits unsupported reasoning for both effective and restored native execution while preserving raw source", () => {
+    const f = fixture(),
+      source = structuredClone(f.row.source),
+      request = f.command();
+    Object.assign(f.options.adapter, { reasoningLevels: () => [] });
+    f.set(true);
+    const sent = f.runtime.beforeTransport(request, "host");
+    expect(sent.options.model).toBe(profile.model);
+    expect(sent.options).not.toHaveProperty("reasoningLevel");
+    expect(
+      f.runtime.snapshot().receipts.thread!.effective.reasoningLevel,
+    ).toBeNull();
+    f.set(false);
+    const restored = f.runtime.beforeTransport(request, "host");
+    expect(restored.options).toMatchObject({
+      model: original.model,
+      serviceTier: original.serviceTier,
+      permissionMode: "full",
+      source: "client/turn/requested",
+      providerOptions: request.options.providerOptions,
+    });
+    expect(restored.options).not.toHaveProperty("reasoningLevel");
+    expect(request.options.reasoningLevel).toBe(original.reasoningLevel);
+    expect(f.row.source).toEqual(source);
+  });
+  it.each(["thread.start", "turn.submit"])(
+    "%s overlays explicit and queued execution without changing source, input or permission fields",
+    (type) => {
+      const f = fixture(),
+        before = structuredClone(f.row);
+      f.set(true);
+      const requested = { ...f.command(), type, input: "same input" },
+        sent = f.runtime.beforeTransport(requested, "host");
+      expect(sent.options).toMatchObject(profile);
+      expect(sent.options.permissionMode).toBe("full");
+      expect(sent.options.source).toBe("client/turn/requested");
+      expect(sent.input).toBe(requested.input);
+      expect(requested.options).toMatchObject(original);
+      expect(f.row).toEqual(before);
+      expect(
+        f.runtime.snapshot().markers.thread![requested.requestId]!.requested,
+      ).toEqual(original);
+    },
+  );
+  it("keeps an effective profile for a steer-to-start race without claiming the active call switched", () => {
+    const f = fixture();
+    f.set(true);
+    const request = {
+      ...f.command(),
+      target: { mode: "auto", expectedTurnId: "active" },
+    };
+    expect(f.runtime.beforeTransport(request, "host").options).toMatchObject(
+      profile,
+    );
+    expect(f.runtime.snapshot().receipts.thread).toBeUndefined();
+  });
+  it("OFF at the final boundary wins over earlier ON preparation and restores by request ID", () => {
+    const f = fixture();
+    f.set(true);
+    const request = f.command();
+    f.runtime.record("thread", request.requestId, request.options);
+    const overlaid = f.runtime.beforeTransport(request, "host");
+    f.set(false);
+    expect(f.runtime.beforeTransport(overlaid, "host").options).toMatchObject(
+      original,
+    );
+    expect(
+      f.runtime.restore("thread", request.requestId, {
+        ...profile,
+        permissionMode: "full",
+        source: "native",
+      }),
+    ).toEqual({ ...original, permissionMode: "full", source: "native" });
+  });
+  it("immutable null inheritance, Fast disabled and permission source survive restore", () => {
+    const f = fixture();
+    f.row.source.lastExecution = null;
+    f.row.source.defaults = original;
+    f.row.source.allowFastServiceTier = false;
+    f.set(true);
+    const request = f.command();
+    f.runtime.record("thread", request.requestId, request.options);
+    f.set(false);
+    expect(f.runtime.beforeTransport(request, "host").options).toMatchObject({
+      ...original,
+      serviceTier: "default",
+    });
+    expect(
+      f.runtime.restore("thread", request.requestId, {
+        ...profile,
+        permissionMode: "workspace",
+        source: "native",
+      }),
+    ).toEqual({ permissionMode: "workspace", source: "native" });
+  });
+  it("keeps every request marker through native append rollback and restart without loading the plugin", () => {
+    const f = fixture();
+    f.set(true);
+    const a = f.command(),
+      b = f.command();
+    f.runtime.record("thread", a.requestId, a.options);
+    f.runtime.record("thread", b.requestId, b.options);
+    const restarted = createExecutionPolicyRuntime(f.options);
+    expect(
+      restarted.restore("thread", a.requestId, {
+        ...profile,
+        permissionMode: "full",
+      }),
+    ).toEqual({ ...original, permissionMode: "full" });
+    expect(restarted.restore("thread", b.requestId, { ...profile })).toEqual(
+      original,
+    );
+    expect(
+      restarted.beforeTransport(f.command(), "host").options,
+    ).toMatchObject(original);
+    restarted.attach();
+    expect(
+      restarted.beforeTransport(f.command(), "host").options,
+    ).toMatchObject(profile);
+    restarted.detach();
+    expect(
+      restarted.beforeTransport(f.command(), "host").options,
+    ).toMatchObject(original);
+  });
+  it("native availability and target host are rechecked after preparation", () => {
+    const f = fixture();
+    f.set(true);
+    f.row.available = false;
+    expect(f.runtime.dispatchWait("thread")).toBeTruthy();
+    expect(() => f.runtime.beforeTransport(f.command(), "host")).toThrow(
+      /unavailable/,
+    );
+    f.row.available = true;
+    expect(() =>
+      f.runtime.beforeTransport(f.command(), "different-host"),
+    ).toThrow(/host changed/);
+    f.set(false);
+    expect(
+      f.runtime.beforeTransport(f.command(), "host").options,
+    ).toMatchObject(original);
+  });
+  it("never starts dormant threads and leaves another provider and non-turn commands unchanged", () => {
+    const f = fixture();
+    f.row.archived = true;
+    f.row.paused = true;
+    f.row.status = "error";
+    f.rows.push({
+      ...structuredClone(f.row),
+      id: "other",
+      providerId: "other-provider",
+    });
+    f.set(true);
+    expect(f.runtime.status().eligible).toBe(0);
+    const other = { ...f.command(), threadId: "other" };
+    expect(f.runtime.beforeTransport(other, "host")).toBe(other);
+    const stop = { ...f.command(), type: "thread.stop" };
+    expect(f.runtime.beforeTransport(stop, "host")).toBe(stop);
+  });
+  it("refuses conflicting source writes and does not silently persist explicit picks", () => {
+    const f = fixture();
+    f.set(true);
+    expect(f.runtime.suppressSticky("thread")).toBe(true);
+    expect(() => f.runtime.guard("thread")).toThrow(/Turn off/);
+    f.row.source.modelOverride = "changed";
+    expect(() => f.runtime.beforeTransport(f.command(), "host")).toThrow(
+      /immutable/,
+    );
+    expect(
+      f.runtime.snapshot().cycle!.snapshots.thread!.source.modelOverride,
+    ).toBeNull();
+  });
+  it("deduplicates UUIDs across restart and rejects reused IDs or stale generations", () => {
+    const f = fixture(),
+      id = randomUUID();
+    f.runtime.set({ enabled: true, expectedGeneration: 0, requestId: id });
+    f.runtime.set({ enabled: true, expectedGeneration: 0, requestId: id });
+    expect(f.runtime.status().generation).toBe(1);
+    const restarted = createExecutionPolicyRuntime(f.options);
+    restarted.attach();
+    restarted.set({ enabled: true, expectedGeneration: 0, requestId: id });
+    expect(restarted.status().generation).toBe(1);
+    expect(() =>
+      restarted.set({ enabled: false, expectedGeneration: 1, requestId: id }),
+    ).toThrow(/another action/);
+    expect(() =>
+      restarted.set({
+        enabled: false,
+        expectedGeneration: 0,
+        requestId: randomUUID(),
+      }),
+    ).toThrow(/another device/);
+  });
+  it("corrupt journals block only the scoped execution without inferring OFF", () => {
+    const f = fixture();
+    writeFileSync(f.statePath, '{"version":1}');
+    const bad = createExecutionPolicyRuntime(f.options);
+    expect(bad.status().available).toBe(false);
+    expect(() => bad.beforeTransport(f.command(), "host")).toThrow(/journal/);
+    expect(() => bad.attach()).toThrow(/journal/);
+    const other = { ...f.command(), threadId: "unrelated" };
+    expect(bad.beforeTransport(other, "host")).toBe(other);
+  });
+  it("a failed delivery-receipt write preserves the accepted transport result and does not send twice", () => {
+    const f = fixture();
+    let fail = false;
+    const runtime = createExecutionPolicyRuntime({
+      ...f.options,
+      writeState: () => {
+        if (fail) throw Error("disk full");
+      },
+    });
+    runtime.attach();
+    runtime.set({
+      enabled: true,
+      expectedGeneration: 0,
+      requestId: randomUUID(),
+    });
+    const request = f.command();
+    runtime.beforeTransport(request, "host");
+    fail = true;
+    expect(() => runtime.transportResult(request, { ok: true })).not.toThrow();
+    expect(runtime.status().error).toMatch(/receipt/);
+  });
+  it("restores a newly created explicit profile without flattening the immutable null source snapshot", () => {
+    const f = fixture();
+    f.set(true);
+    const row = {
+      ...structuredClone(f.row),
+      id: "new",
+      source: {
+        ...f.row.source,
+        lastExecution: null,
+        defaults: { model: null, reasoningLevel: null, serviceTier: null },
+      },
+    };
+    f.rows.push(row);
+    f.runtime.noteCreation(row.id, {
+      model: "new-primary",
+      reasoningLevel: "high",
+      serviceTier: "fast",
+    });
+    const command = {
+      ...f.command(),
+      threadId: row.id,
+      options: {
+        model: "new-primary",
+        reasoningLevel: "high",
+        serviceTier: "fast",
+        permissionMode: "full",
+      },
+    };
+    f.runtime.record(row.id, command.requestId, command.options);
+    f.runtime.beforeTransport(command, "host");
+    f.set(false);
+    expect(f.runtime.beforeTransport(command, "host").options).toEqual(
+      command.options,
+    );
+    expect(
+      f.runtime.snapshot().cycle!.snapshots.new!.source.lastExecution,
+    ).toBeNull();
+  });
+  it("treats deletion of an existing native journal as corruption rather than an implicit OFF", () => {
+    const f = fixture();
+    f.set(true);
+    rmSync(f.statePath);
+    const runtime = createExecutionPolicyRuntime({
+      ...f.options,
+      allowMissing: false,
+    });
+    expect(runtime.status().available).toBe(false);
+    expect(() => runtime.beforeTransport(f.command(), "host")).toThrow(
+      /journal/,
+    );
+  });
+});
diff --git a/apps/server/src/services/execution-policies/runtime.ts b/apps/server/src/services/execution-policies/runtime.ts
new file mode 100644
index 0000000..9d6d3be
--- /dev/null
+++ b/apps/server/src/services/execution-policies/runtime.ts
@@ -0,0 +1,667 @@
+import { createHash, randomUUID } from "node:crypto";
+import {
+  closeSync,
+  existsSync,
+  fsyncSync,
+  mkdirSync,
+  openSync,
+  readFileSync,
+  renameSync,
+  unlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { dirname } from "node:path";
+import { z } from "zod";
+import { reasoningLevelSchema, serviceTierSchema } from "@bb/domain";
+import type {
+  ExperimentalExecutionProfile,
+  ExperimentalExecutionPolicyIssue,
+  ExperimentalExecutionPolicySet,
+  ExperimentalExecutionPolicyState,
+} from "@get-bb/plugin-sdk";
+
+export const executionPolicySemantics = [
+  "final-host-boundary",
+  "explicit-and-queued",
+  "preserve-source-and-null",
+  "durable-request-provenance",
+  "immutable-cycle-snapshots",
+  "cas-and-request-dedup",
+  "safe-native-boundaries",
+  "native-host-catalog",
+  "restore-after-unload",
+  "catalog-profile-validation",
+  "native-host-handshake",
+  "consistent-durable-registry",
+] as const;
+export const executionProfileSchema = z
+  .object({
+    model: z.string().min(1).max(200),
+    reasoningLevel: reasoningLevelSchema,
+    serviceTier: serviceTierSchema,
+  })
+  .strict();
+const profileFieldsSchema = z.object({
+  model: z.string().nullable(),
+  reasoningLevel: z.string().nullable(),
+  serviceTier: z.string().nullable(),
+});
+export type ProfileFields = z.infer<typeof profileFieldsSchema>;
+const sourceSchema = z.object({
+  providerId: z.string(),
+  allowFastServiceTier: z.boolean(),
+  modelOverride: z.string().nullable(),
+  reasoningLevelOverride: z.string().nullable(),
+  lastExecution: profileFieldsSchema.nullable(),
+  defaults: profileFieldsSchema,
+});
+const snapshotSchema = z.object({
+  source: sourceSchema,
+  creation: profileFieldsSchema.nullable(),
+  sessionSnapshot: z.unknown(),
+  capturedAt: z.number(),
+  hostId: z.string().nullable(),
+});
+const cycleSchema = z.object({
+  id: z.uuid(),
+  snapshots: z.record(z.string(), snapshotSchema),
+});
+const markerSchema = z.object({
+  requestId: z.string(),
+  lastExecution: profileFieldsSchema.nullable(),
+  requested: profileFieldsSchema,
+  restoreProfile: profileFieldsSchema,
+  generation: z.number().int().nonnegative(),
+  cycleId: z.uuid(),
+});
+const receiptSchema = z.object({
+  generation: z.number(),
+  requestId: z.string(),
+  hostId: z.string(),
+  overlay: z.boolean(),
+  effective: profileFieldsSchema,
+  accepted: z.boolean(),
+  failure: z.string().nullable(),
+});
+const stateSchema = z
+  .object({
+    version: z.literal(1),
+    providerId: z.string(),
+    profile: executionProfileSchema,
+    generation: z.number().int().nonnegative(),
+    phase: z.enum(["off", "enabling", "on", "disabling"]),
+    cycle: cycleSchema.nullable(),
+    history: z.array(cycleSchema),
+    markers: z.record(z.string(), z.record(z.string(), markerSchema)),
+    receipts: z.record(z.string(), receiptSchema),
+    operations: z.record(
+      z.string(),
+      z.object({ enabled: z.boolean(), generation: z.number() }),
+    ),
+    conflicts: z.record(z.string(), z.string()),
+  })
+  .strict()
+  .refine((s) => s.phase === "off" || s.cycle !== null);
+type State = z.infer<typeof stateSchema>;
+export type ExecutionPolicySource = z.infer<typeof sourceSchema>;
+export interface ExecutionPolicyRow {
+  id: string;
+  providerId: string;
+  hostId: string | null;
+  deleted: boolean;
+  archived: boolean;
+  paused: boolean;
+  status: string;
+  activeTurnId: string | null;
+  lastRequestId: string | null;
+  available: boolean;
+  unavailableReason: string | null;
+  source: ExecutionPolicySource;
+  sessionSnapshot: unknown;
+}
+export interface ExecutionPolicyAdapter {
+  list(): ExecutionPolicyRow[];
+  get(id: string): ExecutionPolicyRow | null;
+  reasoningLevels?(threadId: string, model: string): readonly string[] | null;
+}
+export interface ExecutionPolicyCommand {
+  type: string;
+  threadId: string;
+  requestId: string;
+  options: Record<string, unknown>;
+  target?: { mode?: string; expectedTurnId?: string | null };
+}
+const clone = <T>(v: T): T => structuredClone(v);
+const digest = (v: unknown) =>
+  createHash("sha256").update(JSON.stringify(v)).digest("hex");
+const intent = (source: ExecutionPolicySource) => ({
+  ...source,
+  lastExecution: null,
+});
+export const profileFields = (
+  v: {
+    model?: unknown;
+    reasoningLevel?: unknown;
+    serviceTier?: unknown;
+  } | null,
+): ProfileFields | null =>
+  v === null
+    ? null
+    : {
+        model: typeof v.model === "string" ? v.model : null,
+        reasoningLevel:
+          typeof v.reasoningLevel === "string" ? v.reasoningLevel : null,
+        serviceTier: typeof v.serviceTier === "string" ? v.serviceTier : null,
+      };
+export class ExecutionPolicyConflict extends Error {
+  readonly code = "execution_policy_conflict";
+}
+export function createExecutionPolicyRuntime(args: {
+  statePath: string;
+  providerId: string;
+  profile: ExperimentalExecutionProfile;
+  adapter: ExecutionPolicyAdapter;
+  changed?: () => void;
+  now?: () => number;
+  allowMissing?: boolean;
+  writeState?: (state: State) => void;
+}) {
+  const profile = executionProfileSchema.parse(args.profile),
+    now = args.now ?? Date.now;
+  let state: State = {
+    version: 1,
+    providerId: args.providerId,
+    profile,
+    generation: 0,
+    phase: "off",
+    cycle: null,
+    history: [],
+    markers: {},
+    receipts: {},
+    operations: {},
+    conflicts: {},
+  };
+  const creations = new Map<string, ProfileFields | null>();
+  let loadError: string | null = null,
+    resultWriteError: string | null = null,
+    attached = false;
+  try {
+    state = stateSchema.parse(JSON.parse(readFileSync(args.statePath, "utf8")));
+    if (
+      state.providerId !== args.providerId ||
+      digest(state.profile) !== digest(profile)
+    )
+      throw Error("Policy identity changed");
+  } catch (error) {
+    if (
+      !args.allowMissing ||
+      !(error instanceof Error && "code" in error && error.code === "ENOENT")
+    )
+      loadError =
+        "Could not read the execution-policy journal. Dispatch is blocked until recovery.";
+  }
+  const desired = () => state.phase === "on" || state.phase === "enabling";
+  const enabled = () => attached && desired();
+  const check = () => {
+    if (loadError) throw Error(loadError);
+  };
+  const inScope = (row: ExecutionPolicyRow | null): row is ExecutionPolicyRow =>
+    row !== null && row.providerId === args.providerId && !row.deleted;
+  function persist(next: State) {
+    check();
+    if (args.writeState) args.writeState(clone(next));
+    else {
+      mkdirSync(dirname(args.statePath), { recursive: true, mode: 0o700 });
+      const tmp = args.statePath + "." + randomUUID() + ".tmp";
+      let fd: number | null = null;
+      try {
+        fd = openSync(tmp, "wx", 0o600);
+        writeFileSync(fd, JSON.stringify(next));
+        fsyncSync(fd);
+        closeSync(fd);
+        fd = null;
+        renameSync(tmp, args.statePath);
+        const directory = openSync(dirname(args.statePath), "r");
+        try {
+          fsyncSync(directory);
+        } finally {
+          closeSync(directory);
+        }
+      } finally {
+        if (fd !== null) closeSync(fd);
+        if (existsSync(tmp)) unlinkSync(tmp);
+      }
+    }
+    state = next;
+    args.changed?.();
+  }
+  const change = (fn: (s: State) => void) => {
+    const next = clone(state);
+    fn(next);
+    persist(next);
+  };
+  function capture(row: ExecutionPolicyRow) {
+    if (!enabled() || !inScope(row) || state.cycle?.snapshots[row.id]) return;
+    change((s) => {
+      if (!s.cycle) throw Error("Missing active cycle");
+      s.cycle.snapshots[row.id] = {
+        source: clone(row.source),
+        creation: clone(creations.get(row.id) ?? null),
+        sessionSnapshot: clone(row.sessionSnapshot),
+        capturedAt: now(),
+        hostId: row.hostId,
+      };
+    });
+  }
+  function restoreProfile(
+    source: ExecutionPolicySource,
+    last: ProfileFields | null,
+  ): ProfileFields {
+    return {
+      model: source.modelOverride ?? last?.model ?? source.defaults.model,
+      reasoningLevel:
+        source.reasoningLevelOverride ??
+        last?.reasoningLevel ??
+        source.defaults.reasoningLevel,
+      serviceTier: source.allowFastServiceTier
+        ? (last?.serviceTier ?? source.defaults.serviceTier ?? "default")
+        : "default",
+    };
+  }
+  function reconcile() {
+    check();
+    const rows = args.adapter.list(),
+      pending: ExperimentalExecutionPolicyIssue[] = [],
+      unavailable: ExperimentalExecutionPolicyIssue[] = [],
+      conflicts: ExperimentalExecutionPolicyIssue[] = [];
+    if (enabled()) for (const row of rows) capture(row);
+    for (const row of rows.filter(inScope)) {
+      const snapshot = state.cycle?.snapshots[row.id];
+      if (
+        desired() &&
+        snapshot &&
+        digest(intent(row.source)) !== digest(intent(snapshot.source))
+      )
+        conflicts.push({
+          threadId: row.id,
+          reason:
+            "Original settings differ from the immutable activation snapshot.",
+        });
+      const stored = state.receipts[row.id],
+        receipt = stored?.requestId === row.lastRequestId ? stored : null;
+      if (enabled() && receipt?.overlay && receipt.failure)
+        unavailable.push({
+          threadId: row.id,
+          hostId: row.hostId,
+          reason: receipt.failure,
+        });
+      if (row.archived || row.paused || row.status === "error") continue;
+      const active =
+        Boolean(row.activeTurnId) ||
+        row.status === "active" ||
+        row.status === "stopping";
+      if (enabled()) {
+        if (!row.available)
+          unavailable.push({
+            threadId: row.id,
+            hostId: row.hostId,
+            reason:
+              row.unavailableReason ??
+              "The policy model is unavailable on the target host.",
+          });
+        if (
+          active &&
+          (!receipt ||
+            receipt.generation !== state.generation ||
+            !receipt.accepted)
+        )
+          pending.push({
+            threadId: row.id,
+            reason:
+              "The current turn continues. The profile applies at the next safe native boundary.",
+          });
+      } else if (active && receipt?.overlay)
+        pending.push({
+          threadId: row.id,
+          reason:
+            "The current turn is finishing. The original profile applies to the next turn.",
+        });
+    }
+    const phase = enabled()
+      ? pending.length || unavailable.length || conflicts.length
+        ? "enabling"
+        : "on"
+      : desired() && !attached
+        ? state.phase
+        : pending.length
+          ? "disabling"
+          : "off";
+    if (phase !== state.phase)
+      change((s) => {
+        s.phase = phase;
+      });
+    return { rows, pending, unavailable, conflicts };
+  }
+  const api = {
+    noteCreation(
+      threadId: string,
+      request: {
+        model?: unknown;
+        reasoningLevel?: unknown;
+        serviceTier?: unknown;
+      },
+    ) {
+      creations.set(threadId, profileFields(request));
+    },
+    initialize() {
+      if (!existsSync(args.statePath)) persist(state);
+    },
+    suspend() {
+      attached = false;
+    },
+    attach() {
+      check();
+      attached = true;
+    },
+    detach() {
+      attached = false;
+      if (desired())
+        change((s) => {
+          s.generation++;
+          s.phase = "disabling";
+        });
+    },
+    enabled,
+    selected: desired,
+    profile,
+    capture,
+    status(): ExperimentalExecutionPolicyState {
+      let view;
+      try {
+        view = reconcile();
+      } catch (error) {
+        return {
+          available: !loadError,
+          phase: state.phase,
+          generation: state.generation,
+          enabled: enabled(),
+          profile,
+          eligible: 0,
+          ready: 0,
+          pending: [],
+          unavailable: [],
+          conflicts: [],
+          error:
+            loadError ??
+            (error instanceof Error
+              ? error.message
+              : "Journal state is unconfirmed."),
+        };
+      }
+      const eligible = view.rows.filter(
+        (r) => inScope(r) && !r.archived && !r.paused && r.status !== "error",
+      );
+      return {
+        available: !loadError,
+        phase: state.phase,
+        generation: state.generation,
+        enabled: enabled(),
+        profile,
+        eligible: eligible.length,
+        ready: enabled()
+          ? Math.max(
+              0,
+              eligible.length -
+                new Set(
+                  [...view.pending, ...view.unavailable, ...view.conflicts].map(
+                    (x) => x.threadId,
+                  ),
+                ).size,
+            )
+          : 0,
+        pending: view.pending,
+        unavailable: view.unavailable,
+        conflicts: [
+          ...view.conflicts,
+          ...Object.entries(state.conflicts).map(([threadId, reason]) => ({
+            threadId,
+            reason,
+          })),
+        ],
+        error: resultWriteError,
+      };
+    },
+    set(input: ExperimentalExecutionPolicySet) {
+      check();
+      if (!attached)
+        throw new ExecutionPolicyConflict("This policy handle is released.");
+      const {
+        enabled: want,
+        expectedGeneration,
+        requestId,
+      } = z
+        .object({
+          enabled: z.boolean(),
+          expectedGeneration: z.number().int().nonnegative(),
+          requestId: z.uuid(),
+        })
+        .strict()
+        .parse(input);
+      const previous = state.operations[requestId];
+      if (previous) {
+        if (previous.enabled !== want)
+          throw new ExecutionPolicyConflict(
+            "This operation ID was used for another action.",
+          );
+        return api.status();
+      }
+      if (state.generation !== expectedGeneration)
+        throw new ExecutionPolicyConflict(
+          "State changed on another device. Refresh the state.",
+        );
+      if (want === enabled()) {
+        change((s) => {
+          s.operations[requestId] = { enabled: want, generation: s.generation };
+        });
+        return api.status();
+      }
+      const rows = args.adapter.list();
+      change((s) => {
+        if (want) {
+          s.conflicts = {};
+          if (s.cycle) s.history.push(s.cycle);
+          s.cycle = {
+            id: randomUUID(),
+            snapshots: Object.fromEntries(
+              rows.filter(inScope).map((row) => [
+                row.id,
+                {
+                  source: clone(row.source),
+                  creation: clone(creations.get(row.id) ?? null),
+                  sessionSnapshot: clone(row.sessionSnapshot),
+                  capturedAt: now(),
+                  hostId: row.hostId,
+                },
+              ]),
+            ),
+          };
+        }
+        s.generation++;
+        s.phase = want ? "enabling" : "disabling";
+        s.operations[requestId] = { enabled: want, generation: s.generation };
+      });
+      return api.status();
+    },
+    guard(threadId: string) {
+      check();
+      if (!enabled() && !(attached && state.phase === "disabling")) return;
+      const row = args.adapter.get(threadId);
+      if (!inScope(row)) return;
+      capture(row);
+      change((s) => {
+        s.conflicts[threadId] =
+          "Changing the original profile while the policy is active was refused. Turn it off first.";
+      });
+      throw new ExecutionPolicyConflict(
+        "Turn off the active execution policy before changing individual settings.",
+      );
+    },
+    suppressSticky(threadId: string) {
+      check();
+      return (
+        (enabled() || (attached && state.phase === "disabling")) &&
+        inScope(args.adapter.get(threadId))
+      );
+    },
+    record(
+      threadId: string,
+      requestId: string,
+      execution: Record<string, unknown>,
+    ) {
+      check();
+      if (!enabled()) return;
+      const row = args.adapter.get(threadId);
+      if (!inScope(row)) return;
+      capture(row);
+      const snapshot = state.cycle?.snapshots[threadId];
+      if (!snapshot) return;
+      const prior = Object.values(state.markers[threadId] ?? {}).find(
+        (m) => m.cycleId === state.cycle?.id,
+      );
+      const original = prior
+        ? prior.lastExecution
+        : (snapshot.source.lastExecution ??
+          (snapshot.creation ? profileFields(execution) : null));
+      change((s) => {
+        if (!s.cycle) throw Error("Missing active cycle");
+        s.markers[threadId] ??= {};
+        s.markers[threadId]![requestId] = {
+          requestId,
+          lastExecution: original,
+          requested: profileFields(execution)!,
+          restoreProfile: restoreProfile(snapshot.source, original),
+          generation: s.generation,
+          cycleId: s.cycle.id,
+        };
+      });
+    },
+    restore<T extends Record<string, unknown>>(
+      threadId: string,
+      requestId: string,
+      execution: T,
+    ): T {
+      check();
+      const marker = state.markers[threadId]?.[requestId];
+      if (!marker) return execution;
+      const restored = { ...execution };
+      for (const key of ["model", "reasoningLevel", "serviceTier"] as const) {
+        if (marker.lastExecution === null) delete restored[key];
+        else Object.assign(restored, { [key]: marker.lastExecution[key] });
+      }
+      return restored;
+    },
+    beforeTransport<T extends ExecutionPolicyCommand>(
+      command: T,
+      hostId: string,
+    ): T {
+      if (!["thread.start", "turn.submit"].includes(command.type))
+        return command;
+      const row = args.adapter.get(command.threadId);
+      if (!inScope(row)) return command;
+      check();
+      capture(row);
+      const overlay = enabled();
+      if (overlay && !state.markers[row.id]?.[command.requestId])
+        api.record(row.id, command.requestId, command.options);
+      const marker = state.markers[row.id]?.[command.requestId];
+      if (!overlay && !marker) return command;
+      if (overlay && !row.available)
+        throw new ExecutionPolicyConflict(
+          row.unavailableReason ??
+            "The policy model is unavailable on this host.",
+        );
+      if (overlay && row.hostId !== hostId)
+        throw new ExecutionPolicyConflict(
+          "The target host changed before dispatch. Retry after refreshing the native catalog.",
+        );
+      if (
+        overlay &&
+        digest(intent(row.source)) !==
+          digest(intent(state.cycle!.snapshots[row.id]!.source))
+      )
+        throw new ExecutionPolicyConflict(
+          "Original settings conflict with the immutable activation snapshot.",
+        );
+      const restore = marker?.restoreProfile;
+      if (!overlay && restore && !restore.model)
+        throw new ExecutionPolicyConflict(
+          "The inherited original model is unresolved. Select a model before sending.",
+        );
+      const options = { ...command.options, ...(overlay ? profile : restore) };
+      const reasoningLevels =
+        typeof options.model === "string"
+          ? args.adapter.reasoningLevels?.(row.id, options.model)
+          : null;
+      if (
+        reasoningLevels &&
+        !reasoningLevels.includes(String(options.reasoningLevel))
+      )
+        delete (options as Record<string, unknown>).reasoningLevel;
+      if (command.target?.expectedTurnId == null)
+        change((s) => {
+          s.receipts[row.id] = {
+            generation: s.generation,
+            requestId: command.requestId,
+            hostId,
+            overlay,
+            effective: profileFields(options)!,
+            accepted: false,
+            failure: null,
+          };
+        });
+      return { ...command, options };
+    },
+    transportResult(
+      command: ExecutionPolicyCommand,
+      response: { ok: boolean; errorCode?: string } | null,
+      error?: unknown,
+    ) {
+      const receipt = state.receipts[command.threadId];
+      if (
+        !receipt ||
+        receipt.requestId !== command.requestId ||
+        command.target?.expectedTurnId != null
+      )
+        return;
+      try {
+        change((s) => {
+          const r = s.receipts[command.threadId]!;
+          r.accepted = response?.ok === true;
+          r.failure = r.accepted
+            ? null
+            : error
+              ? "Host delivery is unconfirmed. No profile fallback was attempted."
+              : `Host rejected the request: ${String(response?.errorCode ?? "unknown_error").slice(0, 100)}`;
+        });
+        resultWriteError = null;
+      } catch {
+        resultWriteError =
+          "Could not save the delivery receipt. The current work was not interrupted.";
+      }
+    },
+    dispatchWait(threadId: string) {
+      check();
+      if (!enabled()) return null;
+      const row = args.adapter.get(threadId);
+      return inScope(row) && !row.available
+        ? (row.unavailableReason ??
+            "Waiting for the policy model on the target host.")
+        : null;
+    },
+    snapshot: () => clone(state),
+  };
+  return api;
+}
+export type ExecutionPolicyRuntime = ReturnType<
+  typeof createExecutionPolicyRuntime
+>;
