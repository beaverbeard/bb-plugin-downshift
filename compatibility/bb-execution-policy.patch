+import { describe, it, expect } from "vitest";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import type { ThreadEvent } from "@bb/domain";
+import {
+  createScriptedEchoRuntime,
+  createScriptedEchoRequestRecord,
+  fullRuntimeOptions,
+  waitForThreadTurnStarted,
+  waitForThreadTurnCompleted,
+} from "./test/runtime-test-harness.js";
+import { promptTextInput } from "./test/prompt-input.js";
+describe("effective profile at native turn boundaries", () => {
+  it("keeps a live steer on its existing profile and uses the new profile on the following turn", async () => {
+    const directory = mkdtempSync(join(tmpdir(), "bb-policy-steer-")),
+      record = createScriptedEchoRequestRecord(),
+      events: ThreadEvent[] = [];
+    const runtime = createScriptedEchoRuntime({
+      runtime: {
+        workspacePath: directory,
+        env: record.env,
+        onEvent: (event) => events.push(event),
+      },
+    });
+    const active = {
+        ...fullRuntimeOptions,
+        model: "active-model",
+        reasoningLevel: "high" as const,
+      },
+      next = {
+        ...fullRuntimeOptions,
+        model: "next-model",
+        reasoningLevel: "low" as const,
+      };
+    try {
+      await runtime.startThread({
+        environmentId: "env",
+        threadId: "thread",
+        projectId: "project",
+        providerId: "fake",
+        options: active,
+      });
+      await runtime.runTurn({
+        threadId: "thread",
+        clientRequestId: "creq_222222223a",
+        input: [promptTextInput({ text: "delay:500 active" })],
+        options: active,
+      });
+      const { turnId } = await waitForThreadTurnStarted({
+        events,
+        providerId: "fake",
+        runtime,
+        threadId: "thread",
+      });
+      await runtime.steerTurn({
+        threadId: "thread",
+        expectedTurnId: turnId,
+        clientRequestId: "creq_222222223b",
+        input: [promptTextInput({ text: "steer" })],
+        options: next,
+      });
+      expect(record.last("turn/steer")?.params).toMatchObject({
+        options: {
+          model: "active-model",
+          reasoningLevel: "high",
+          permissionMode: "full",
+        },
+      });
+      await waitForThreadTurnCompleted({
+        events,
+        providerId: "fake",
+        threadId: "thread",
+      });
+      await runtime.runTurn({
+        threadId: "thread",
+        clientRequestId: "creq_222222223c",
+        input: [promptTextInput({ text: "next" })],
+        options: next,
+      });
+      expect(record.last("turn/start")?.params).toMatchObject({
+        options: { model: "next-model", reasoningLevel: "low" },
+      });
+    } finally {
+      await runtime.shutdown();
+      rmSync(directory, { recursive: true, force: true });
+      rmSync(dirname(record.path), { recursive: true, force: true });
+    }
+  });
+});
