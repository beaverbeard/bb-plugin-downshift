diff --git a/packages/plugin-sdk/src/execution-policy.ts b/packages/plugin-sdk/src/execution-policy.ts
new file mode 100644
index 0000000..f48a731
--- /dev/null
+++ b/packages/plugin-sdk/src/execution-policy.ts
@@ -0,0 +1,47 @@
+/** A server-owned effective profile. It never grants provider, permission, input or history authority. */
+export interface ExperimentalExecutionProfile {
+  model: string;
+  reasoningLevel: string;
+  serviceTier: string;
+}
+export interface ExperimentalExecutionPolicyIssue {
+  threadId: string;
+  hostId?: string | null;
+  reason: string;
+}
+export interface ExperimentalExecutionPolicyState {
+  available: boolean;
+  phase: "off" | "enabling" | "on" | "disabling";
+  generation: number;
+  enabled: boolean;
+  profile: ExperimentalExecutionProfile;
+  eligible: number;
+  ready: number;
+  pending: ExperimentalExecutionPolicyIssue[];
+  unavailable: ExperimentalExecutionPolicyIssue[];
+  conflicts: ExperimentalExecutionPolicyIssue[];
+  error: string | null;
+}
+export interface ExperimentalExecutionPolicySet {
+  enabled: boolean;
+  expectedGeneration: number;
+  requestId: string;
+}
+export interface ExperimentalExecutionPolicyController {
+  status(): ExperimentalExecutionPolicyState;
+  set(input: ExperimentalExecutionPolicySet): ExperimentalExecutionPolicyState;
+  subscribe(changed: () => void): () => void;
+  /** Deactivate new overlays. Durable original-execution readers outlive this handle. */
+  release(): void;
+}
+/** Experimental server-owned effective-execution integration. See docs/api_to_audit.md. */
+export interface ExperimentalExecutionPolicies {
+  /** consistent-durable-registry requires startup inventory validation and blocks dispatch and provenance reads on registry loss. */
+  describe(): { protocol: string; semantics: readonly string[] };
+  /** Register a provider-scoped profile, attributed to the calling plugin. One live owner per provider. */
+  register(policy: {
+    id: string;
+    providerId: string;
+    profile: ExperimentalExecutionProfile;
+  }): ExperimentalExecutionPolicyController;
+}
