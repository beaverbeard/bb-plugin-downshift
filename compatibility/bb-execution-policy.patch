+        if (!thread) continue;
+        const hostId = threadTargetHostId(deps, thread);
+        if (!hostId || !deps.hub.hasDaemonForHost(hostId)) continue;
+        const key = JSON.stringify([
+          r.entry.providerId,
+          r.entry.profile,
+          hostId,
+          thread.projectId,
+          thread.environmentId,
+        ]);
+        let load = loads.get(key);
+        if (!load || load.until <= Date.now()) {
+          const next = {
+            until: Infinity,
+            promise: Promise.resolve<unknown>(null),
+          };
+          next.promise = resolveSystemExecutionOptionsForValidation(
+            deps,
+            {
+              hostId,
+              providerId: r.entry.providerId,
+              projectId: thread.projectId,
+              ...(thread.environmentId
+                ? { environmentId: thread.environmentId }
+                : {}),
+            },
+            r.entry.profile.model,
+          )
+            .catch(() => null)
+            .finally(() => {
+              next.until = Date.now() + 30000;
+            });
+          load = next;
+          loads.set(key, next);
+        }
+        let timer: ReturnType<typeof setTimeout> | undefined;
+        try {
+          await Promise.race([
+            load.promise,
+            new Promise<void>((resolve) => {
+              timer = setTimeout(resolve, 12000);
+              timer.unref();
+            }),
+          ]);
+        } finally {
+          clearTimeout(timer);
+        }
+      }
+    },
+  };
+  return api;
+}
